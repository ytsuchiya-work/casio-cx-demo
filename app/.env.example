# --- Databricks ワークスペース ---
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com
# 認証（いずれか1つ）
#  1) サービスプリンシパル（EC2 推奨）: OAuth M2M
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
#  2) 個人アクセストークン
DATABRICKS_TOKEN=
#  3) ローカル開発: Databricks CLI のプロファイル（databricks auth login 済み）
DATABRICKS_PROFILE=

# --- データの場所 ---
UC_CATALOG=main
UC_SCHEMA=casio_cx
SERVING_SCHEMA=casio_cx_serving
WAREHOUSE_ID=
JOB_ID=
LAKEBASE_ENDPOINT=projects/casio-cx-demo/branches/production/endpoints/primary
LAKEBASE_DATABASE=databricks_postgres

PORT=8080
